# Copy this file to .env for local development. Never commit .env.

# Free key from https://steamcommunity.com/dev/apikey (your Steam account must
# have spent at least $5 on the store). Needed for scripts/build_data.py index
# and the My Steam library tools. Everything else works without it.
STEAM_API_KEY=

# Public URL of the site. Used in link previews and the User-Agent we send.
SITE_URL=http://127.0.0.1:5000

FLASK_DEBUG=1
